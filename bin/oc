#!/usr/bin/env bash
# Submit work to Hermes, the orchestrator of this workspace, from any tool (OpenCode relay agent,
# Claude Code, Cline, plain shell). Hermes plans the route and runs the OpenCode specialist agents.
#
#   oc <route> "<request>"        e.g. oc feature "add pull-to-refresh on garden list"   (routes: oc routes)
#   oc ask "<request>"            no route: Hermes picks the smallest one
#   oc agent <name> "<task>"      one step with one specialist, e.g. oc agent scout "where are tokens stored?"
#   oc cmd <route> "<request>"    old syntax, same as `oc <route>`
#   ... --async                   return a task id at once, then: oc wait <task_id> [--max 240] (live progress, then
#                                 the answer) | oc watch <task_id> (progress stream until it ends) | oc status <task_id>
#   oc proof <task_id> | --system  prove from evidence that Hermes orchestrated it (exit 1 if not)
# The request can also come on stdin (heredoc), which avoids shell quoting of user text.
# Project: the registered workspace containing the working directory, or AGENT_OS_PROJECT=<id> (which must
# contain the working directory). There is no default project: anything else is refused.
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
AGENT_OS_HOME="${AGENT_OS_HOME:-$HOME/ferry-dev/hermes-agent-os}"
[ -f "$AGENT_OS_HOME/bin/hermes-task.mjs" ] || { echo "hermes-agent-os not found at $AGENT_OS_HOME (set AGENT_OS_HOME)" >&2; exit 2; }
[ $# -gt 0 ] || { sed -n '2,14p' "$0"; exit 2; }
[ "$1" = proof ] && { shift; exec node "$AGENT_OS_HOME/bin/agentos.mjs" proof "$@"; }
[ -n "${AGENT_OS_PROJECT:-}" ] && exec node "$AGENT_OS_HOME/bin/hermes-task.mjs" --project "$AGENT_OS_PROJECT" "$@"
exec node "$AGENT_OS_HOME/bin/hermes-task.mjs" "$@"
